# Copy to .env and fill in. Never commit the real .env.

# URL of your JARVIS HTTP endpoint that accepts {"text": "..."} and returns {"reply": "..."}
JARVIS_ENDPOINT=https://dein-jarvis-host:8080/alexa

# Optional: sent as "Authorization: Bearer <key>" to JARVIS
JARVIS_API_KEY=

# Optional: seconds before giving up (Alexa aborts at ~8s, so keep <= 7)
JARVIS_TIMEOUT=7

# Recommended: only accept requests from your skill (find it in the Alexa dev console)
ALEXA_SKILL_ID=

# Only used by local_server.py
BIND_HOST=0.0.0.0
BIND_PORT=8088
